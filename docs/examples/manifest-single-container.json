{
  "schemaVersion": "1.0",
  "releaseId": "rel-2026-10-25-001",
  "appId": "edge-api",
  "releaseType": "single_container",
  "createdAt": "2026-10-25T09:30:00Z",
  "metadata": {
    "appVersion": "2.4.1"
  },
  "compatibility": {
    "os": ["linux"],
    "arch": ["amd64"],
    "minAgentVersion": "1.2.0",
    "minDockerVersion": "24.0.0"
  },
  "container": {
